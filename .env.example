# Copy this file to .env and fill in local credentials as needed.
# Never commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# Optional OpenAI-compatible fallback.
# Use official API keys or compatible provider API keys, not ChatGPT web account cookies/tokens.
ACTIVE_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODEL_FLASH=
OPENAI_MODEL_PRO=
OPENAI_GATEWAY_HOST=127.0.0.1
OPENAI_GATEWAY_PORT=3010
OPENAI_GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
OPENAI_GATEWAY_TIMEOUT_SECONDS=60

# Optional scholarly provider credentials / contact metadata.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
